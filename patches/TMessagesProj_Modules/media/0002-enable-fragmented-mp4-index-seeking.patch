+          && bundle.fragmentIndexPosition != C.INDEX_UNSET
+          && !bundle.fragmentHasTfdt) {
+        // Without independent decode times, seeking must retain the preceding fragments.
+        fragmentIndexUsesTfdt = false;
+        fragmentIndexSeekMap =
+            seekMap =
+                new IndexSeekMap(
+                    new long[] {firstFragmentPosition}, new long[] {0}, seekMap.getDurationUs());
+        outputFragmentIndexSeekMap();
+      }
+    }
+    if (!fragmentIndexUsesTfdt || fragmentIndexComplete) {
+      return;
